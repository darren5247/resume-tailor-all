# Neon / Vercel Postgres. Required on Vercel so profile, settings, and run progress persist.
# Storage → Create Database → Neon, then pull env vars or paste the connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Vercel Blob. Required on Vercel so generated resumes can be downloaded.
# Storage → Create Store → Blob, connect it to this project (sets BLOB_READ_WRITE_TOKEN).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional Google Sheets tracker. Share the spreadsheet with the service account as Editor.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# GOOGLE_SHEET_TAB=Sheet1
